# Obvezno: API ključ iz https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model (haiku = poceni in hiter; za boljše odgovore claude-sonnet-5-5)
MODEL=claude-haiku-5-5

# KOMU ODGOVARJA
# Po imenu: WhatsApp profilno ime sogovornika (tisto, ki si ga je nastavil SAM), ločeno z vejico
ALLOWED_NAMES=MRGAZO
# Po številki (zanesljivejše): z mednarodno kodo, brez + in presledkov, npr. 38640123456
ALLOWED_NUMBERS=
# Če sta oba prazna, odgovarja VSEM zasebnim pogovorom (skupine se vedno ignorirajo).

# Povezava s kodo namesto QR (priporočeno na Railwayu): TVOJA številka, na kateri teče WhatsApp
PAIRING_NUMBER=

# Kje se shrani prijava in zgodovina (na Railwayu: /data/auth z volumnom)
AUTH_DIR=./auth

# Navodila, kako naj bot odgovarja (ton, kaj sme/ne sme reči)
# SYSTEM_PROMPT="Odgovarjaj sproščeno, kot Luka. ..."

# Ali naj prvemu sporočilu doda opombo, da odgovarja AI
AI_DISCLOSURE=true
# DISCLOSURE_TEXT="🤖 (Samodejni odgovor – trenutno odgovarja AI asistent.)"

# Koliko ms počaka po zadnjem sporočilu, preden odgovori
DEBOUNCE_MS=6000
MAX_HISTORY=30
